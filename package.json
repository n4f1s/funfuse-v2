{
  "name": "funfuse-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:screenshots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-screenshots.ts",
    "dev": "pnpm generate:screenshots && next dev",
    "build": "pnpm generate:screenshots && next build",
    "start": "next start",
    "lint": "pnpm generate:screenshots && eslint",
    "typecheck": "pnpm generate:screenshots && tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
