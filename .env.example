# FunFuse Games — environment
#
# Copy to `.env.local` (git-ignored) and fill in the real values. Nothing here
# is read at build time: the site builds and every page renders without any of
# it. The only thing that needs the mail variables is pressing submit on a
# form, and a form with no configuration says "write to us directly" instead of
# failing.
#
# `.env.local` must never be committed. Set the same keys in the hosting
# provider's environment for preview and production.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# The origin this deployment serves from, no trailing slash. Canonical URLs,
# the sitemap and OG tags are built from it, so a preview deploy that leaves
# this unset will point search engines at production.
# Defaults to https://funfusegames.com when absent.
NEXT_PUBLIC_SITE_URL=https://funfusegames.com

# ---------------------------------------------------------------------------
# Mail — https://resend.com
# ---------------------------------------------------------------------------

# Server-side only. Never prefix this with NEXT_PUBLIC_, which would ship the
# key to every visitor's browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# The envelope sender. The domain has to be verified in Resend or the API
# rejects the send, so this is a funfusegames.com address, not the visitor's.
# The visitor's address goes on Reply-To instead, which is what makes hitting
# reply in the inbox answer them.
CONTACT_FROM_EMAIL="FunFuse Games <website@funfusegames.com>"

# Where the general contact form lands.
CONTACT_TO_EMAIL=support@funfusegames.com

# Where applications from the careers page land. Optional: falls back to
# CONTACT_TO_EMAIL, so one missing variable cannot lose a candidate.
CAREERS_TO_EMAIL=hr@funfusegames.com

# Note on the CV attachment: the careers form takes a file up to 5MB and puts
# it on the email as an attachment. That needs headroom in the Server Action
# body limit, which is set to 6mb in next.config.ts — the two move together.
# Resend's own ceiling is 40MB per message, so it is not the binding one.
